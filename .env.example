# WordPress (headless CMS) — REST API base is {WP_API_URL}/wp-json
WP_API_URL=https://travelution.com.pk

# Contact Form 7 form ID used by /api/contact (WP Admin → Contact → shortcode id)
WP_CF7_FORM_ID=

# Shared secret for the WP → Next revalidation webhook (/api/revalidate)
REVALIDATE_SECRET=change-me

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Client-review demo: contact form shows success without sending anything
DEMO_MODE=true
